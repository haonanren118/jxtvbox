# JXTVbox 环境变量示例 —— 复制为 .env 后编辑（.env 已被 .dockerignore/.gitignore 忽略）

# 【必填】访问密码。不设置时站点提示需配置，且全部 API 返回 503。
PASSWORD=change-me

# 服务端口（容器内固定 8080，改这里只影响宿主机映射外的直接运行场景）
PORT=8080

# 本地/NAS 媒体目录：宿主机路径，挂载到容器 /media/local1（配合 MEDIA_DIRS 使用）
MEDIA_DIR1=./media

# 直播源允许内网地址（udpxy 推流、内网 M3U/EPG 源场景必须设为 1）
LIVE_ALLOW_PRIVATE=1

# 可选：预置点播源（Apple CMS 采集站），JSON 数组，仅在首次启动 / 新源追加时生效
# DEFAULT_SOURCES=[{"name":"示例源","url":"https://example.com/api.php/provide/vod"}]

# 可选：预置直播源（M3U 订阅），JSON 数组
# DEFAULT_LIVE_SOURCES=[{"name":"IPTV","url":"https://example.com/live.m3u","epg":"https://example.com/epg.xml"}]

# 可选：反向代理 HTTPS 下强制 Secure cookie（默认按协议自动判定）
# COOKIE_SECURE=true
